{
  "version": 1,
  "author": "Aluno",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 100,
      "left": 100,
      "attrs": {}
    },
    {
      "type": "wokwi-ntc-temperature-sensor",
      "id": "ntc",
      "top": -80,
      "left": 100,
      "attrs": {
        "temperature": "24"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led",
      "top": 80,
      "left": 360,
      "attrs": {
        "color": "red"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "res",
      "top": 160,
      "left": 360,
      "rotate": 90,
      "attrs": {
        "value": "220"
      }
    },
    {
      "type": "wokwi-buzzer",
      "id": "buzzer",
      "top": -60,
      "left": 360,
      "attrs": {
        "volume": "0.5"
      }
    }
  ],
  "connections": [
    [ "esp:3V3", "ntc:VCC", "red", [ "h-20", "v-80" ] ],
    [ "esp:GND.1", "ntc:GND", "black", [ "h-40", "v-100" ] ],
    [ "esp:D34", "ntc:OUT", "green", [ "v-30", "h-60" ] ],
    [ "esp:D23", "led:A", "orange", [ "h20", "v-20" ] ],
    [ "led:C", "res:1", "black", [ "v0" ] ],
    [ "res:2", "esp:GND.2", "black", [ "v20", "h-150" ] ],
    [ "esp:D19", "buzzer:2", "purple", [ "h30", "v-120" ] ],
    [ "buzzer:1", "esp:GND.3", "black", [ "v40", "h-120" ] ]
  ],
  "dependencies": {}
}
